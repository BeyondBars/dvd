# Copy to .env.local (gitignored) to override .env.development locally.

# Laravel API base URL (must match APP_URL in api/.env)
VITE_API_URL=http://localhost:8000

# Browser tab title
VITE_APP_TITLE="Desi Videshi Diner"

# Optional: link to your terms & conditions page (defaults to "#")
VITE_TERMS_URL=
